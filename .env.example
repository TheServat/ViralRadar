# ─────────────────────────────────────────────────────────────
#  Trend Radar — configuration
#  Copy this file to `.env`. Every value below has a safe default;
#  the app runs with an EMPTY .env (Google Trends + Hacker News + RSS
#  need no credentials at all).
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=7788
HOST=127.0.0.1
# Optional: require this token on every /api call (sent as ?token= or X-Radar-Token).
# Leave empty for a local-only, no-auth setup (default, safe on 127.0.0.1).
API_TOKEN=

# ── Storage ──────────────────────────────────────────────────
DB_PATH=./data/radar.db
# Delete raw content older than N days (metric history is trimmed with it)
RETENTION_DAYS=30
# Keep aggregated daily trend history for N days
TREND_HISTORY_DAYS=365

# ── What "here" means: regions / languages you produce content for ──
# Comma-separated ISO country codes used by Google Trends and YouTube.
# Examples: US   |   US,GB,DE   |   IR   |   US,IR
REGIONS=US
# Comma-separated ISO-639-1 codes to KEEP (empty = keep every language).
# A standing preference, not a hard rule: the dashboard filter overrides it, and
# items whose language could not be detected are never hidden by it.
LANGUAGES=

# ── Scheduler (minutes) ──────────────────────────────────────
DISCOVERY_INTERVAL_MIN=20
HOT_REFRESH_MIN=5
NORMAL_REFRESH_MIN=60
ANALYZE_INTERVAL_MIN=10
# Run a collection pass immediately when the server starts
RUN_ON_START=true

# ── Sources: enable/disable ──────────────────────────────────
# Comma-separated ids. Available: googletrends,hackernews,rss,youtube,reddit,telegram
SOURCES_ENABLED=googletrends,hackernews,rss,youtube,reddit,telegram

# ── YouTube (the most important source: real view counts) ────
# Free key, ~2 minutes to create:
#   console.cloud.google.com -> New project -> APIs & Services
#   -> Enable "YouTube Data API v3" -> Credentials -> Create API key
# Without a key the youtube source reports CONFIGURATION_REQUIRED and is skipped.
YOUTUBE_API_KEY=
# Discovery is OPEN by default: nothing is named in advance, so any channel can
# surface - including one nobody has heard of yet. Add channel ids here only to
# ALSO follow specific channels closely.
YOUTUBE_WATCH_CHANNELS=

# ── YouTube open discovery ───────────────────────────────────────
# Some countries have no YouTube trending chart at all (Iran among them), but
# `search` does accept their region code. These are not topics to look for -
# they are the widest net the API allows, since a search needs a query string.
# Each run rotates through them and alternates between "already pulling views"
# and "just uploaded". Leave empty to switch open discovery off.
YOUTUBE_SEARCH_TERMS=
# Searches per discovery run. Each costs 100 of the 10,000 free daily units.
YOUTUBE_SEARCHES_PER_RUN=1
# Ceiling on daily search spend. Open discovery pauses rather than exhausting
# the quota, leaving room for chart reads and metric refreshes (1 unit each).
YOUTUBE_QUOTA_BUDGET=7000
# Only consider uploads from the last N hours - older is not "right now".
YOUTUBE_SEARCH_WINDOW_HOURS=48

# ── Reddit ───────────────────────────────────────────────────
# Reddit blocks anonymous JSON from many networks. The official free path:
#   reddit.com/prefs/apps -> "create another app" -> type: script
#   -> copy the client id (under the app name) and the secret.
# Leave empty to try the anonymous public JSON endpoint (often 403).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Sent as User-Agent; Reddit asks for a descriptive one including your username.
REDDIT_USER_AGENT=trend-radar/1.0 (personal research)
REDDIT_FEEDS=r/all/rising,r/popular/hot,r/all/top?t=hour

# ── Generic RSS / Atom feeds ─────────────────────────────────
# Comma separated. Any RSS or Atom URL, including YouTube channel feeds.
RSS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://hnrss.org/frontpage,https://www.theverge.com/rss/index.xml

# ── Telegram (public channel previews, t.me/s/<name>) ────────
# Comma separated public channel usernames, no @. Empty = source disabled.
TELEGRAM_CHANNELS=

# ── Outbound network ─────────────────────────────────────────
# DIRECT | HTTP_PROXY | SOCKS5   (SOCKS5 covers Tor: socks5://127.0.0.1:9050)
NETWORK_MODE=DIRECT
PROXY_URL=
HTTP_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=3
# Global politeness cap: max requests per second to any single host
HOST_RATE_LIMIT_RPS=1

# ── Scoring weights (must be tuned, not required to change) ──
W_VELOCITY=0.30
W_ACCELERATION=0.30
W_ANOMALY=0.15
W_ENGAGEMENT=0.10
W_CROSS_SOURCE=0.10
W_FRESHNESS=0.05
# Content older than this many hours is never shown as "trending now"
MAX_AGE_HOURS=72
# Half-life used by the freshness decay
FRESHNESS_HALFLIFE_HOURS=8

# ── Optional AI (everything works with this empty) ───────────
# ollama | openai | anthropic   — used ONLY for naming clusters and
# writing "why is this trending" explanations. Never for detection.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
