# ─────────────────────────────────────────────────────────────
#  Viral Radar — configuration
#
#  Copy this file to `.env`. Every value below has a working default, and the
#  program runs with an EMPTY .env: ten sources need no credentials at all.
#
#  Everything here is also editable from the Settings page in the dashboard,
#  which links to wherever each key is obtained. Editing this file by hand and
#  editing it from the browser are the same thing — comments and ordering are
#  preserved either way.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=7788
HOST=127.0.0.1
# Optional: require this token on every /api call (sent as ?token= or X-Radar-Token).
# Leave empty for a local-only, no-auth setup — safe on 127.0.0.1, and the
# server refuses to start on any other host without one.
API_TOKEN=

# ── Storage ──────────────────────────────────────────────────
DB_PATH=./data/radar.db
# Delete content older than N days; its metric history goes with it.
RETENTION_DAYS=30
# Keep events and topic history for N days. Small tables; a year is cheap.
TREND_HISTORY_DAYS=365
# Hourly hashtag counts, which are not. One row per hashtag per hour bucket:
# about 123,000 rows a day on a real database, and roughly 3 GB at a year.
# Only the current hour and the one before it are ever read, so two weeks
# loses nothing you can ask for.
KEYWORD_HISTORY_DAYS=14

# ── Who you are making content for ───────────────────────────
# Comma-separated ISO country codes. Used by Google Trends, Google News and
# YouTube — each is asked about every country listed.
# Examples:  US   |   US,GB,DE   |   IR   |   IR,US
# Also decides whose searches the Gaps page compares against your videos: it
# reads Google Trends for these countries, so leaving it empty means American
# searches even when everything you make is in another language.
REGIONS=US

# Countries the free trend feeds read, which is a different question. A YouTube
# region costs API quota; a Google Trends region costs one request. Write "all"
# for thirty verified countries, or a list like IR,US,TR. Empty follows REGIONS.
#
# Watching widely is how you find a subject climbing somewhere else that nobody
# has made for your audience — the Gaps page ranks by how many countries want a
# subject, because one country is local news and six is a phenomenon that
# travels. Costs about ninety seconds per discovery run at thirty countries.
TRENDS_REGIONS=

# Comma-separated ISO-639-1 codes to KEEP. Empty means every language.
# A standing preference, not a hard rule: the filter on any page overrides it,
# and items whose language could not be detected are never hidden by it.
# Also selects which Wikipedia editions and which Google News language to read.
LANGUAGES=

# ── Sources: which plugins run at all ────────────────────────
# Available: googletrends googlenews wikipedia hackernews rss youtube reddit
#            telegram mastodon bluesky github charts imgur twitch tmdb
#            producthunt giphy
# Everything that works with no configuration, plus the ones that take a key.
# A keyed source with no key says it needs one rather than failing quietly, so
# adding a key on the Settings page is enough - you do not also have to come
# back here and enable it.
SOURCES_ENABLED=googletrends,googlenews,wikipedia,hackernews,rss,youtube,reddit,telegram,mastodon,bluesky,github,charts

# ── Scheduler (minutes) ──────────────────────────────────────
# Discovery finds new content; refresh re-measures what is already known.
# The refresh is what produces velocity — without a second measurement there
# is no growth to compute, so this is the setting that matters most.
DISCOVERY_INTERVAL_MIN=20
HOT_REFRESH_MIN=5
NORMAL_REFRESH_MIN=60
ANALYZE_INTERVAL_MIN=10
RUN_ON_START=true

# ═════════════════════════════════════════════════════════════
#  Sources that need no credentials
# ═════════════════════════════════════════════════════════════

# ── Generic RSS / Atom ───────────────────────────────────────
# Any feed URL, including YouTube channel feeds. These carry no metrics; their
# job is corroborating a story the metric-bearing sources also see.
RSS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://hnrss.org/frontpage,https://www.theverge.com/rss/index.xml

# ── Mastodon ─────────────────────────────────────────────────
# Public trending endpoints: posts, hashtags and shared links, with real
# favourite, boost and reply counts. Large general servers see the widest
# slice of the federated network.
MASTODON_HOSTS=mastodon.social,mstdn.social,fosstodon.org

# ── Bluesky ──────────────────────────────────────────────────
# Public AT Protocol feeds. Any public feed generator's AT-URI works here.
BLUESKY_FEEDS=at://did:plc:z72i7hdynmk6r22z27h6tvur/app.bsky.feed.generator/whats-hot

# ── GitHub ───────────────────────────────────────────────────
# Repositories created recently, ranked by stars. A token is optional and only
# raises the rate limit; unauthenticated search is already enough for this.
GITHUB_TOKEN=
GITHUB_WINDOW_DAYS=7,30
GITHUB_PER_PAGE=40

# ── Charts: Steam, Apple, Spotify ────────────────────────────
# Charts publish a position rather than a count, so rank becomes the score and
# climbing the chart reads as growth. Steam also gives concurrent players,
# which is a real number.
CHARTS_STEAM=true
CHARTS_SPOTIFY=true
# Apple storefronts, two-letter codes. Not every country has one; Iran does not.
APPLE_COUNTRIES=us
APPLE_CHARTS=podcasts/top,music/most-played,apps/top-free

# ── Telegram ─────────────────────────────────────────────────
# Public channel previews (t.me/s/<name>) — the same page a browser shows
# without an account. Carries a real view count per post, which makes this one
# of the few sources with genuine reach attached to each item.
# Public channels only, listed explicitly. Empty disables the source.
TELEGRAM_CHANNELS=

# ═════════════════════════════════════════════════════════════
#  Sources that need one free key each
#
#  None of these require payment details. Until a key is set, the source
#  reports CONFIGURATION_REQUIRED and is skipped — it never invents data to
#  look like it is working.
# ═════════════════════════════════════════════════════════════

# ── YouTube — the most valuable source here ──────────────────
# The only one that hands over a real view counter. Two minutes:
#   console.cloud.google.com -> New project -> APIs & Services
#   -> enable "YouTube Data API v3" -> Credentials -> Create API key
YOUTUBE_API_KEY=

# Discovery is OPEN by default: nothing is named in advance, so any channel can
# surface — including one nobody has heard of yet. Add ids here only to ALSO
# follow specific channels closely.
YOUTUBE_WATCH_CHANNELS=

# Some countries have no YouTube trending chart at all (Iran among them), but
# `search` does accept their region code. These are not topics to look for —
# they are the widest net the API allows, since a search needs a query string.
# Empty switches open discovery off.
YOUTUBE_SEARCH_TERMS=
# Each search costs 100 of the 10,000 free daily units.
YOUTUBE_SEARCHES_PER_RUN=1
# Ceiling on daily search spend, leaving room for chart reads and refreshes.
YOUTUBE_QUOTA_BUDGET=7000
YOUTUBE_SEARCH_WINDOW_HOURS=48

# ── Reddit ───────────────────────────────────────────────────
# Reddit refuses anonymous JSON from most networks. The official free path:
#   reddit.com/prefs/apps -> "create another app" -> type: script
#   -> copy the client id (under the app name) and the secret
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit asks for a descriptive User-Agent including your username.
REDDIT_USER_AGENT=viral-radar/1.0 (personal research)
REDDIT_FEEDS=r/all/rising,r/popular/hot,r/all/top?t=hour

# ── Imgur — the purest virality signal here ──────────────────
# A real view counter per post, in a gallery where an image either takes off
# within hours or disappears.
#   api.imgur.com/oauth2/addclient
#   -> "anonymous usage without user authorisation" -> copy the Client ID
IMGUR_CLIENT_ID=
# `viral` is what the gallery promotes; `rising` is what is still climbing.
IMGUR_SECTIONS=viral,rising
IMGUR_INCLUDE_MATURE=false

# ── Twitch — people watching right now ───────────────────────
# The only source that measures live attention rather than an accumulated
# total, which nothing else in this system can see.
#   dev.twitch.tv/console/apps/create
#   -> category "Application Integration", redirect http://localhost
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Extra passes by language, so a smaller local scene is not buried under the
# global top. Empty means the global list only.
TWITCH_LANGUAGES=

# ── TMDB — film and television ───────────────────────────────
# A popularity figure recomputed daily, so it moves.
#   themoviedb.org -> Settings -> API -> request an API key (v3 auth)
TMDB_API_KEY=
TMDB_LANGUAGE=en-US

# ── Product Hunt — launches and their votes ──────────────────
#   producthunt.com/v2/oauth/applications -> create an application
#   -> "Create developer token" on the same page
PRODUCTHUNT_TOKEN=
PRODUCTHUNT_WINDOW_DAYS=2

# ── Giphy — where a reaction format spreads first ────────────
# Rank only: Giphy publishes no counts, so this is coarser than the rest and
# its reliability score says so.
#   developers.giphy.com/dashboard -> create an app -> copy the API key
GIPHY_API_KEY=
GIPHY_RATING=pg-13

# ═════════════════════════════════════════════════════════════
#  Tuning
# ═════════════════════════════════════════════════════════════

# ── Outbound network ─────────────────────────────────────────
# DIRECT | HTTP_PROXY
# Routing only. Nothing here bypasses a rate limit, a ban or an access control.
# For SOCKS clients, point PROXY_URL at their HTTP port instead:
#   Xray / V2Ray: usually http://127.0.0.1:10809
#   Tor: add "HTTPTunnelPort 9080" to torrc, then http://127.0.0.1:9080
#
# These two are the only settings that need a restart for a reason other than
# a port or a file already being open: Node decides whether to read proxy
# settings from the environment before this program starts, so changing them
# in the dashboard says "restart required" and means it. Until you do, traffic
# still goes the old way.
NETWORK_MODE=DIRECT
PROXY_URL=
HTTP_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=3
# Politeness cap: maximum requests per second to any single host.
HOST_RATE_LIMIT_RPS=1

# ── Scoring weights ──────────────────────────────────────────
# Sixty percent of the weight is on growth rather than size, which is why a
# small post climbing fast outranks a large one that has stopped moving.
# Raise W_ACCELERATION to catch things earlier, at the cost of more noise.
W_VELOCITY=0.30
W_ACCELERATION=0.30
W_ANOMALY=0.15
W_ENGAGEMENT=0.10
W_CROSS_SOURCE=0.10
W_FRESHNESS=0.05
# Content older than this stops counting as "right now".
MAX_AGE_HOURS=72
# How quickly age discounts an item.
FRESHNESS_HALFLIFE_HOURS=8

# ── Your clock ───────────────────────────────────────────────────
# The timezone "best time to post" is expressed in. An IANA name, so daylight
# saving is handled for you. Empty uses this machine's own zone, which is worth
# checking: a laptop set up elsewhere, a VPS, or a container will happily report
# a zone thousands of kilometres from you, and every hour on the page would be
# quietly wrong. The resolved zone is shown on the page for exactly that reason.
# Examples: Asia/Tehran, Europe/Istanbul, Asia/Dubai, UTC
TIMEZONE=Asia/Tehran

# ── Notifications ────────────────────────────────────────────
# The radar only earns its keep if it can tell you something is taking off
# while it still is. Leave NOTIFY_CHANNELS empty and none of this runs.
# telegram, webhook, or both, comma separated.
NOTIFY_CHANNELS=
# Telegram: message @BotFather, send /newbot, paste the token here.
NOTIFY_TELEGRAM_BOT_TOKEN=
# Where to send. Message @userinfobot for your own id. Send your new bot one
# message first, or Telegram will not let it write to you.
NOTIFY_TELEGRAM_CHAT_ID=
# Anything that accepts a POST. Discord and Slack incoming webhooks work as-is.
NOTIFY_WEBHOOK_URL=
# viral        something crossed into taking off
# breakout     an account did far better than it normally does
# intervention a source stopped and needs you
NOTIFY_KINDS=viral,breakout,intervention
# Two filters against false alarms. Confidence is what stops a single early
# measurement from being announced as a trend.
NOTIFY_MIN_SCORE=65
NOTIFY_MIN_CONFIDENCE=0.5
# From,to on a 24-hour clock. Held rather than dropped: everything arrives when
# the window ends. 0,0 disables it.
NOTIFY_QUIET_HOURS=0,0
NOTIFY_INTERVAL_MIN=10
# One message per check, strongest first, capped here. A digest gets read; a
# wall of notifications gets muted.
NOTIFY_MAX_PER_RUN=8

# ── Settings page password ───────────────────────────────────
# Empty means the Settings page is open to anyone who can reach the dashboard.
# Set it and that page asks for the password before showing anything — which is
# worth doing if this runs on a machine other people use.
#
# It protects the page, not this file: whoever can read this file can read every
# key in it regardless.
SETTINGS_PASSWORD=

# ── Creator baselines ────────────────────────────────────────────
# "40x what this account normally gets" needs to know the normal, and open
# discovery never learns it: it finds one video from a channel and moves on.
# A background job fetches each creator's recent uploads to fill that in,
# starting with the creators whose work actually did well.
#
# For YouTube the channel listing is free (public feed) and pricing the videos
# costs about one quota unit per fifty. Zero switches the job off.
BACKFILL_PER_RUN=60
BACKFILL_INTERVAL_MIN=30

# ── Thumbnails ───────────────────────────────────────────────────
# Measures what the image looks like, so "what works" covers the picture and
# not only the title. Dimensions and busyness need nothing installed;
# brightness, contrast, colour and skin tone use ffmpeg when it is present.
# Zero switches the whole thing off.
MEDIA_PER_RUN=250
MEDIA_INTERVAL_MIN=15

# ── What you make ────────────────────────────────────────────────
# Describe your channel in a sentence or two, in your own language. Not
# keywords — a description. It is matched against items by meaning using the
# embeddings the clustering already builds, so it costs no extra model call.
#
# Needs EMBED_MODEL. Empty means no subject matching at all, and every list
# behaves exactly as before.
INTERESTS=

# ── Semantic clustering (optional) ───────────────────────────────
# Groups stories that mean the same thing but share no words — most usefully
# the same story in Persian and in English, which the word-based clustering
# cannot see at all.
#
# Needs Ollama and one embedding model. Empty means off, and off changes
# nothing: the word-based clustering is the product, this only adds to it.
#
#   ollama pull paraphrase-multilingual     # 562 MB, the tested default
#
# The model is checked before it is trusted: it must show, in each of your
# languages, that it puts related sentences closer than unrelated ones. One
# that cannot is refused rather than used, because a model that scores
# everything alike would merge every topic into one while looking healthy.
EMBED_MODEL=
EMBED_BASE_URL=http://127.0.0.1:11434
# How alike two topics must be to become one. High on purpose: embeddings put
# everything about a subject near everything else about it, and a low value
# collapses a whole subject into a single topic. Measured on a real database:
# 0.86 doubled the cross-language topics with no over-merging, 0.78 produced a
# 264-item blob, and 0.70 an 839-item one. Lower it carefully.
EMBED_MERGE_THRESHOLD=0.86
EMBED_INTERVAL_MIN=12
EMBED_MAX_PER_RUN=600
# How many texts go to the model in one request.
EMBED_BATCH_SIZE=32
# How long to wait for it. The embedding pass is synchronous, so this is
# also the longest the dashboard can stall on a slow or wedged model.
EMBED_TIMEOUT_MS=120000

# ── Optional AI ──────────────────────────────────────────────
# Entirely optional, and empty by default. Used ONLY to name topics and write a
# sentence about why one might be spreading — never for detection, which is
# fully statistical. With this empty the system reports AI_DISABLED and every
# feature still works.
# ollama | openai | anthropic
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
\n
# ── Discovery that learns ────────────────────────────────────────
# YouTube search costs 100 quota units a call; a channel's public feed costs
# nothing. Channels that actually perform are promoted onto a free watch list
# automatically, so discovery stops paying for what it has already learned.
# Nothing is named in advance — the list comes from measured scores.
WATCH_TOP_CREATORS=60
# Several measured items, so one lucky video is not a track record.
WATCH_MIN_ITEMS=2
# The bar is the channel's average score, not its best.
WATCH_MIN_SCORE=30
\n