{
  "name": "viral-radar",
  "version": "0.0.3",
  "private": true,
  "description": "Local-first viral content radar: finds what is exploding on the internet right now, with no topic input required.",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "radar": "./apps/api/src/main.ts"
  },
  "scripts": {
    "start": "node apps/api/src/main.ts serve",
    "setup": "npm install && npm run build && node apps/api/src/main.ts doctor",
    "build": "npm run build --workspace apps/web",
    "web:dev": "npm run dev --workspace apps/web",
    "collect": "node apps/api/src/main.ts collect",
    "analyze": "node apps/api/src/main.ts analyze",
    "doctor": "node apps/api/src/main.ts doctor",
    "sources": "node apps/api/src/main.ts sources",
    "top": "node apps/api/src/main.ts top",
    "reclassify": "node apps/api/src/main.ts reclassify",
    "test": "node --test apps/api/tests/*.test.ts",
    "typecheck": "tsc --noEmit -p apps/api && npm run typecheck --workspace apps/web",
    "bundle": "node scripts/bundle.mjs",
    "package": "npm run build && node scripts/bundle.mjs && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12",
    "resedit": "^2.0.3",
    "typescript": "^5.9.3"
  }
}
